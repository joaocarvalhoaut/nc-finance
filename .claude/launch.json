{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nc-finance-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "nc-finance-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "preview", "--port", "4173", "--strictPort"],
      "port": 4173
    },
    {
      "name": "nc-finance-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "process.env.NODE_ENV='production';process.env.PORT='4180';require('./dist/server.cjs')"],
      "port": 4180
    }
  ]
}
