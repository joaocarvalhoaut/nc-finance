{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "diagnose:whatsapp-zapi": "node scripts/diagnose-whatsapp-zapi.js",
    "e2e:whatsapp": "node scripts/e2e-whatsapp-zapi.js",
    "e2e:whatsapp:report": "node scripts/e2e-whatsapp-zapi.js --report",
    "e2e:whatsapp:live": "LIVE_MODE=true node scripts/e2e-whatsapp-zapi.js --report",
    "test:parser": "npx tsx src/services/localDocumentExtraction/__tests__/normalizeText.test.ts && npx tsx src/services/localDocumentExtraction/__tests__/tableParser.test.ts && npx tsx src/services/localDocumentExtraction/__tests__/regexExtractors.test.ts && npx tsx src/services/localDocumentExtraction/__tests__/heuristics.test.ts && npx tsx src/services/localDocumentExtraction/__tests__/validation.test.ts",
    "test:hardening": "node scripts/hardening.js --report",
    "test:shared": "npx tsx supabase/functions/_shared/__tests__/format.test.ts && npx tsx supabase/functions/_shared/__tests__/phone.test.ts && npx tsx supabase/functions/_shared/__tests__/optOut.test.ts && npx tsx supabase/functions/_shared/__tests__/sanitize.test.ts",
    "test:security": "node tests/hardening.test.mjs",
    "test:files": "node tests/import-files.test.mjs",
    "test:local-db": "node tests/local-db.test.mjs",
    "test:local-auth": "node tests/local-auth.test.mjs",
    "lab:prepare": "node tools/local-lab/prepare.mjs",
    "lab:dev": "node tools/local-lab/serve.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@sentry/react": "^8.55.2",
    "@supabase/supabase-js": "^2.106.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.3.289",
    "posthog-js": "^1.419.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "vite": "^6.2.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "pg": "8.23.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
